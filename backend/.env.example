# Configuración de conexión a SQL Server - Hospital San Gabriel
# Copiar este archivo como .env y ajustar los valores según el entorno local

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=HospitalSanGabrielDB

# Usar "yes" para Autenticación de Windows o "no" para Autenticación de SQL Server
DB_TRUSTED_CONNECTION=yes

# Solo requeridos cuando DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=

DB_TRUST_SERVER_CERTIFICATE=yes
